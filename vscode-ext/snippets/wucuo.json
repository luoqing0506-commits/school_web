{
  "变量（不可变）": {
    "prefix": "量",
    "body": "量 ${1:变量名} = ${2:值}",
    "description": "声明不可变变量"
  },
  "变量（可变）": {
    "prefix": "可变",
    "body": "可变 ${1:变量名} = ${2:值}",
    "description": "声明可变变量"
  },
  "函数定义": {
    "prefix": "功能",
    "body": "功能 ${1:函数名}(${2:参数}) -> ${3:数字} {\n\t${4:逻辑}\n\t返回 ${5:值}\n}",
    "description": "定义函数"
  },
  "纯函数定义": {
    "prefix": "纯功能",
    "body": "纯功能 ${1:函数名}(${2:参数}) -> ${3:数字} {\n\t${4:纯逻辑}\n\t返回 ${5:值}\n}",
    "description": "定义纯函数（禁止副作用）"
  },
  "操作函数定义": {
    "prefix": "操作",
    "body": "操作 ${1:函数名}(${2:参数}) -> ${3:数字} {\n\t${4:可能失败的逻辑}\n\t返回 ${5:值}\n}",
    "description": "定义操作函数（副作用，调用必须捕获）"
  },
  "如果判断": {
    "prefix": "若",
    "body": "若 ${1:条件} {\n\t${2:逻辑}\n}",
    "description": "if 判断"
  },
  "如果否则": {
    "prefix": "否则",
    "body": "否则 {\n\t${1:逻辑}\n}",
    "description": "else 分支"
  },
  "循环": {
    "prefix": "循环",
    "body": "循环 ${1:条件} {\n\t${2:逻辑}\n}",
    "description": "条件循环（while）"
  },
  "遍历": {
    "prefix": "对",
    "body": "对 ${1:元素} 在 ${2:表} {\n\t${3:逻辑}\n}",
    "description": "遍历表/文本"
  },
  "键值对遍历": {
    "prefix": "对键值",
    "body": "对 ${1:键}, ${2:值} 在 ${3:表} {\n\t${4:逻辑}\n}",
    "description": "遍历表的键值对"
  },
  "打印": {
    "prefix": "打印",
    "body": "打印(${1:内容})",
    "description": "输出"
  },
  "错误捕获": {
    "prefix": "捕获",
    "body": "量 ${1:结果} = 捕获(${2:可能出错})\n若 ${1:结果}.成功 {\n\t${3:成功逻辑}\n} 否则 {\n\t${4:处理 ${1:结果}.错误}\n}",
    "description": "捕获错误（必须检查结果）"
  },
  "抛错": {
    "prefix": "抛错",
    "body": "抛错(\"${1:错误消息}\")",
    "description": "抛出错误"
  },
  "管道": {
    "prefix": "管道",
    "body": "${1:值} | ${2:函数}",
    "description": "管道传递"
  },
  "表字面量": {
    "prefix": "表",
    "body": "{\n\t${1:键}: ${2:值}\n}",
    "description": "创建表"
  },
  "导入模块": {
    "prefix": "导入",
    "body": "量 ${1:模块} = 导入(\"${2:文件}.wc\")",
    "description": "导入 wc 模块"
  },
  "导入Python库": {
    "prefix": "导入Python",
    "body": "量 ${1:库名} = 导入Python(\"${1:库名}\")",
    "description": "调用 Python 生态库（FFI）"
  },
  "模板字符串": {
    "prefix": "模板",
    "body": "`${1:文本}${2:${值}}`",
    "description": "模板字符串插值"
  }
}
