// ============================================================
// 模块：数学工具库 (数学工具.wc)
// 被其他文件导入使用
// ============================================================

纯功能 加法(a, b) -> 数字 {
    返回 a + b
}

纯功能 乘法(a, b) -> 数字 {
    返回 a * b
}

纯功能 阶乘(n) -> 数字 {
    若 n <= 1 {
        返回 1
    }
    返回 n * 阶乘(n - 1)
}

量 版本 = "1.0"
