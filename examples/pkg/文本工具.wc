// ============================================================
// 模块：字符串工具库 (文本工具.wc)
// ============================================================

纯功能 反转文本(s) -> 文本 {
    可变 结果 = ""
    对 字 在 s {
        结果 = 字 + 结果
    }
    返回 结果
}

纯功能 统计字数(s) -> 数字 {
    返回 长度(分割(s, " "))
}

量 作者 = "无错语言团队"
