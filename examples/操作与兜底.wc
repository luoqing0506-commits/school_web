// ============================================================
// 无错语言-加强版 示例：操作函数与强制兜底
//
// 三类函数：
//   纯功能 - 纯逻辑，AI 生成不用 Review
//   功能   - 普通函数，可调纯功能
//   操作   - 有副作用的函数（调API/读写文件），编译器强制要求兜底
// ============================================================

// ---- 纯功能：纯逻辑，绝对安全 ----
纯功能 算优惠(原价, 折扣) -> 数字 {
    返回 原价 * 折扣 / 10
}

// ---- 操作：模拟"外部世界"（可能失败）----
操作 查库存(商品) -> 数字 {
    // 模拟：库存系统可能挂掉
    若 商品 == "断货商品" {
        抛错("库存服务暂时不可用")
    }
    返回 42
}

// ---- 操作：模拟支付（也可能失败）----
操作 扣款(金额) -> 文本 {
    若 金额 > 1000 {
        抛错("余额不足")
    }
    返回 "扣款成功"
}

// ---- 主程序：操作必须捕获兜底 ----
打印("=== 购物流程 ===")

量 商品 = "手机"
量 价格 = 100

// 1. 算优惠（纯功能，直接调）
量 优惠价 = 算优惠(价格, 8)
打印(`商品原价 ${价格}，8折后 ${优惠价}`)

// 2. 查库存（操作，必须捕获）
量 库存结果 = 捕获(查库存(商品))
若 库存结果.成功 {
    打印(`库存充足: ${库存结果.值} 件`)
} 否则 {
    打印(`⚠️ 库存查询失败，降级: ${库存结果.错误}`)
    打印("   采用降级方案：显示'库存未知，可下单'")
}

// 3. 扣款（操作，必须捕获）
量 支付结果 = 捕获(扣款(优惠价))
若 支付结果.成功 {
    打印(支付结果.值)
} 否则 {
    打印(`⚠️ 支付失败，降级: ${支付结果.错误}`)
    打印("   采用降级方案：提示用户稍后重试")
}
