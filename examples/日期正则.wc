// ============================================================
// 无错语言-加强版 示例：日期与正则
// ============================================================

打印("=== 日期 ===")
打印("今天:", 日期())
量 今天 = 年月日(日期())
打印(`${今天.年}年${今天.月}月${今天.日}日`)

打印("")
打印("=== 正则匹配 ===")
量 文本 = "我的手机号是 138-1234-5678，邮箱是 test@example.com"
量 手机号 = 匹配("[0-9]{3}-[0-9]{4}-[0-9]{4}", 文本)
若 手机号.成功 {
    打印("找到手机号:", 手机号.匹配)
} 否则 {
    打印("没找到")
}

打印("")
打印("=== 查找全部 ===")
量 数字们 = 查找全部("[0-9]+", "苹果3个 香蕉5根 梨8个")
打印("所有数字:")
对 数 在 数字们 {
    打印("  ", 数)
}

打印("")
打印("=== 正则替换 ===")
量 干净 = 替换正则("[0-9]+", "#", "密码123和456都改了")
打印("替换后:", 干净)
