// ============================================================
// 无错语言-加强版 示例：模块系统（多文件编程）
// 主程序导入两个模块
// ============================================================

// 导入模块（返回导出表）
量 数学 = 导入("pkg/数学工具")
量 文本 = 导入("pkg/文本工具")

打印("=== 使用数学工具模块 ===")
打印("加法(3, 5):", 数学.加法(3, 5))
打印("乘法(4, 6):", 数学.乘法(4, 6))
打印("阶乘(6):", 数学.阶乘(6))
打印("模块版本:", 数学.版本)

打印("")
打印("=== 使用文本工具模块 ===")
打印("反转文本('无错语言'):", 文本.反转文本("无错语言"))
打印("统计字数('今天天气真不错'):", 文本.统计字数("今天天气真不错"))
打印("模块作者:", 文本.作者)

// 模块之间互不干扰：两个模块都定义了不同名字，主程序用自己的变量
量 版本 = "主程序版本"
打印("")
打印("主程序自己的变量:", 版本)
