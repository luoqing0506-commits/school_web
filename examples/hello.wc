// ============================================================
// 无错语言 示例：你好世界 + 基础语法
// ============================================================

打印("你好，世界！")

// 变量（默认不可变）
量 名字 = "张小明"
量 年龄 = 16
打印("我是", 名字, "，今年", 年龄, "岁")

// 可变变量
可变 分数 = 80
分数 = 分数 + 10
打印("加了10分后:", 分数)

// 函数
功能 双倍(x) -> 数字 {
    返回 x * 2
}
打印("双倍(21) =", 双倍(21))

// 精确数字（0.1 + 0.2 == 0.3）
量 精确结果 = 0.1 + 0.2
打印("0.1 + 0.2 =", 精确结果)

// 分支
功能 评级(分数) -> 文本 {
    若 分数 >= 90 {
        返回 "优秀"
    } 否则若 分数 >= 60 {
        返回 "及格"
    } 否则 {
        返回 "不及格"
    }
}
打印("95分 →", 评级(95))
打印("50分 →", 评级(50))

// 循环
可变 总和 = 0
循环 总和 < 5 {
    总和 = 总和 + 1
    打印("循环中:", 总和)
}

// 遍历表
打印("遍历数组:")
对 数 在 {10, 20, 30} {
    打印("  ", 数)
}

// 表（对象式）
量 用户 = { 名: "张三", 年龄: 18, 城市: "北京" }
打印("用户:", 用户.名, "，", 用户.年龄, "岁，在", 用户.城市)

// 错误处理
量 结果 = 捕获(转数字("不是数字"))
若 结果.成功 {
    打印("转换成功:", 结果.值)
} 否则 {
    打印("转换失败:", 结果.错误)
}
