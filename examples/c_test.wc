// ============================================================
// 无错语言 C 编译测试程序
// ============================================================

功能 阶乘(n) -> 数字 {
    若 n <= 1 {
        返回 1
    }
    返回 n * 阶乘(n - 1)
}

打印("=== C 编译测试 ===")
打印("阶乘(10) =", 阶乘(10))

可变 总和 = 0
可变 i = 0
循环 i < 100 {
    总和 = 总和 + i
    i = i + 1
}
打印("1到99总和 =", 总和)

量 名字 = "无错语言"
打印("你好，", 名字)

// 精确小数
量 精确 = 0.1 + 0.2
打印("0.1 + 0.2 =", 精确)
