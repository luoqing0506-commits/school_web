// ============================================================
// 无错语言-加强版 示例：网络请求（HTTP）
// 本地测试服务器 + 真实网站 双验证
// ============================================================

打印("=== 网络测试 ===")

// 1. GET 本地测试服务器
量 响应 = HTTP获取("http://127.0.0.1:8899/api/测试")
若 响应.成功 {
    打印("✅ GET 本地成功，状态码:", 响应.状态)
    打印("响应内容:", 响应.内容)
    量 数据 = 捕获(JSON解码(响应.内容))
    若 数据.成功 {
        打印("✅ JSON 解析:", 数据.值.消息)
    } 否则 {
        打印("JSON 解析失败:", 数据.错误)
    }
} 否则 {
    打印("❌ GET 本地失败:", 响应.错误)
}

打印("")
打印("=== POST 测试 ===")
量 提交数据 = { 名: "无错语言", 版本: "0.2" }
量 发布响应 = HTTP发布("http://127.0.0.1:8899/api/提交", 提交数据)
若 发布响应.成功 {
    打印("✅ POST 成功，状态码:", 发布响应.状态)
    打印("服务器收到:", 发布响应.内容)
} 否则 {
    打印("❌ POST 失败:", 发布响应.错误)
}

打印("")
打印("=== 真实网站测试 ===")
量 网页 = HTTP获取("https://www.baidu.com")
若 网页.成功 {
    打印("✅ 百度可访问，状态码:", 网页.状态, "，内容长度:", 长度(网页.内容))
} 否则 {
    打印("❌ 百度访问失败:", 网页.错误)
}
