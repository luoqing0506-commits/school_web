// ============================================================
// 无错语言-加强版 示例：猜数字游戏 + 时间/随机/数学
// ============================================================

打印("=== 猜数字游戏（1-100）===")
打印("开始时间:", 时间文本())

// 生成随机答案
量 答案 = 随机整数(1, 100)
打印("（悄悄告诉你答案:", 答案, "）")

// 玩家猜 5 次
可变 猜了 = 0
循环 猜了 < 5 {
    猜了 = 猜了 + 1
    // 模拟玩家输入（用随机数模拟猜的过程）
    量 猜测 = 随机整数(1, 100)
    打印(`第${猜了}次猜: ${猜测}`)
    若 猜测 == 答案 {
        打印("🎉 猜中了！用了", 猜了, "次")
        猜了 = 99  // 跳出循环（够用就行）
    } 否则若 猜测 < 答案 {
        打印("  太小了")
    } 否则 {
        打印("  太大了")
    }
}

// 数学函数展示
打印("")
打印("=== 数学函数 ===")
打印("绝对值(-5):", 绝对值(-5))
打印("向下取整(3.7):", 向下取整(3.7))
打印("向上取整(3.2):", 向上取整(3.2))
打印("平方根(16):", 平方根(16))
打印("最大值(1, 9, 4):", 最大值(1, 9, 4))
打印("最小值(1, 9, 4):", 最小值(1, 9, 4))
打印("取模(17, 5):", 取模(17, 5))

// 随机选择
量 选项 = { "石头", "剪刀", "布" }
打印("随机出拳:", 随机选择(选项))

打印("")
打印("结束时间:", 时间文本())
打印("游戏耗时:", 现在() - 现在() + 0, "秒（演示用）")
