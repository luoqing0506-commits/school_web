// 无错语言：冒泡排序
功能 冒泡排序(原数组) -> 表 {
    可变 数组 = 原数组
    量 总数 = 长度(数组)
    对 i 在 0..总数 {
        对 j 在 0..总数 - 2 {
            若 数组[j] > 数组[j + 1] {
                量 临时 = 数组[j]
                数组[j] = 数组[j + 1]
                数组[j + 1] = 临时
            }
        }
    }
    返回 数组
}

量 数据 = { 64, 34, 25, 12, 22, 11, 90 }
打印("排序前:", 数据)
打印("排序后:", 冒泡排序(数据))
