// ============================================================
// 无错语言-加强版 实战项目：日志分析工具
// 模块化设计：统计模块(日志统计.wc) + 主程序
// 使用：文件/字符串/表/模块/数学/时间
// ============================================================

量 统计 = 导入("日志统计")

打印("========================================")
打印("  服务器日志分析工具")
打印("========================================")
打印("开始时间:", 时间文本())

// 1. 读取日志文件
量 日志文件 = "服务器日志.txt"
若 非 存在(日志文件) {
    抛错("找不到日志文件: " + 日志文件)
}
量 内容 = 读文件(日志文件)
打印("")
打印("📄 日志文件大小:", 长度(内容), "字符")

// 2. 按行分割
量 所有行 = 分割(内容, "\n")
打印("   共", 长度(所有行), "行日志")

// 3. 统计级别
打印("")
打印("📊 日志级别统计:")
量 统计结果 = 统计.统计级别(所有行)
对 键 在 键(统计结果) {
    量 数量 = 统计结果[键]
    打印(`   ${键}: ${数量} 条`)
}

// 4. 找错误日志
打印("")
打印("❌ ERROR 日志明细:")
量 错误行 = 统计.找行(所有行, "[ERROR]")
对 行 在 错误行 {
    打印("   ", 行)
}

// 5. 找警告日志
打印("")
打印("⚠️ WARN 日志明细:")
量 警告行 = 统计.找行(所有行, "[WARN]")
对 行 在 警告行 {
    打印("   ", 行)
}

// 6. 计算错误率
量 错误率 = 统计结果.ERROR / 长度(所有行) * 100
打印("")
打印("📈 错误率: ", 错误率, "%")
若 错误率 > 20 {
    打印("   ⚠️ 错误率过高，需要检查！")
} 否则 {
    打印("   ✅ 错误率在正常范围")
}

// 7. 写分析报告
可变 报告 = "日志分析报告\n"
报告 = 报告 + "时间: " + 时间文本() + "\n"
报告 = 报告 + "总行数: " + 转文本(长度(所有行)) + "\n"
报告 = 报告 + "INFO: " + 转文本(统计结果.INFO) + "\n"
报告 = 报告 + "WARN: " + 转文本(统计结果.WARN) + "\n"
报告 = 报告 + "ERROR: " + 转文本(统计结果.ERROR) + "\n"
报告 = 报告 + "错误率: " + 转文本(错误率) + "%\n"
写文件("分析报告.txt", 报告)
打印("")
打印("✅ 分析报告已写入 分析报告.txt")
打印("完成时间:", 时间文本())
