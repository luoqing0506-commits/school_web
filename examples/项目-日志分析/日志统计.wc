// ============================================================
// 模块：日志统计工具 (日志统计.wc)
// 被主程序导入，纯函数（无副作用）
// ============================================================

// 从一行日志提取级别（INFO/WARN/ERROR）
纯功能 提取级别(行) -> 文本 {
    量 开头 = 行[20:25]
    若 包含(行, "[INFO]") {
        返回 "INFO"
    } 否则若 包含(行, "[WARN]") {
        返回 "WARN"
    } 否则若 包含(行, "[ERROR]") {
        返回 "ERROR"
    }
    返回 "未知"
}

// 统计各级别出现次数，返回表
纯功能 统计级别(所有行) -> 表 {
    可变 结果 = { INFO: 0, WARN: 0, ERROR: 0 }
    对 行 在 所有行 {
        量 级别 = 提取级别(行)
        若 含(结果, 级别) {
            结果[级别] = 结果[级别] + 1
        }
    }
    返回 结果
}

// 找出含关键词的行
纯功能 找行(所有行, 关键词) -> 表 {
    可变 命中 = {}
    可变 序号 = 0
    对 行 在 所有行 {
        若 包含(行, 关键词) {
            命中[序号] = 行
            序号 = 序号 + 1
        }
    }
    返回 命中
}
