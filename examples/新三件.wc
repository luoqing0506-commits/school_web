// ============================================================
// 无错语言-加强版 示例：管道 + OOP + 元编程（新三件）
// ============================================================

打印("=== 1. 管道 |（数据流式处理）===")
功能 双倍(x) -> 数字 { 返回 x * 2 }
功能 加一(x) -> 数字 { 返回 x + 1 }
功能 平方(x) -> 数字 { 返回 x * x }

量 管道结果 = 5 | 双倍 | 加一 | 平方
打印("5 | 双倍 | 加一 | 平方 =", 管道结果)

打印("")
打印("=== 2. OOP（自身 this）===")
功能 新建账户(姓名, 初始余额) -> 表 {
    返回 {
        姓名: 姓名,
        余额: 初始余额,
        存款: 功能(金额) {
            自身.余额 = 自身.余额 + 金额
            返回 自身.余额
        },
        取款: 功能(金额) {
            若 金额 > 自身.余额 {
                抛错("余额不足")
            }
            自身.余额 = 自身.余额 - 金额
            返回 自身.余额
        },
        查询: 功能() -> 文本 {
            返回 自身.姓名 + "的余额: " + 转文本(自身.余额)
        }
    }
}

量 账户 = 新建账户("张小明", 1000)
打印(账户.查询())
打印("存 500 →", 账户.存款(500))
打印("取 200 →", 账户.取款(200))
量 失败 = 捕获(账户.取款(99999))
若 失败.成功 {
    打印("取款成功")
} 否则 {
    打印("取款失败（兜底）:", 失败.错误)
}
打印(账户.查询())

打印("")
打印("=== 3. 元编程 @（运算符函数）===")
打印("@add(10, 20) =", @add(10, 20))
打印("@mul(6, 7) =", @mul(6, 7))
打印("@eq(3, 3) =", @eq(3, 3))
量 自定义 = 功能(a, b, 运算) {
    返回 运算(a, b)
}
打印("把 @sub 当参数传:", 自定义(100, 30, @sub))
