// ============================================================
// 无错语言-加强版 示例：词频统计器（真实程序！）
// 读一个文本文件 -> 统计每个词出现次数 -> 写结果到新文件
// 展示：文件读写 / 分割 / 表操作 / 排序 / JSON
// ============================================================

// 纯函数：把一个词转成干净的小写形式
纯功能 清洗词(词) -> 文本 {
    返回 小写(去空格(词))
}

// 主程序
量 路径 = "examples/文章.txt"

// 1. 检查文件是否存在
若 非 存在(路径) {
    打印("找不到文件:", 路径)
    抛错("文件不存在")
}

// 2. 读取文件
量 内容 = 读文件(路径)
打印("=== 读文件成功 ===")
打印("原文前80字:", 内容[0:80])
打印("总长度:", 长度(内容))

// 3. 按空格和换行分割成词
量 词表 = 分割(内容, " ")
打印("分割后词数:", 长度(词表))

// 4. 统计词频
可变 词频 = {}
对 词 在 词表 {
    量 干净词 = 清洗词(词)
    若 长度(干净词) > 0 {
        若 含(词频, 干净词) {
            词频[干净词] = 词频[干净词] + 1
        } 否则 {
            词频[干净词] = 1
        }
    }
}

// 5. 输出前几个词的统计
打印("")
打印("=== 词频统计 ===")
对 键 在 键(词频) {
    打印(`  ${键}: ${词频[键]} 次`)
}

// 6. 把结果写成 JSON 文件
量 结果JSON = JSON编码(词频)
写文件("examples/词频结果.json", 结果JSON)
打印("")
打印("✅ 结果已写入 examples/词频结果.json")
