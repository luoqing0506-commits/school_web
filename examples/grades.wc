// ============================================================
// 无错语言 示例：学生成绩管理系统
// 展示：纯函数 / 表 / 遍历 / 错误处理 / 精确数字 / 模板字符串
// ============================================================

// 纯函数：计算平均分（禁止副作用）
纯功能 平均分(成绩表) -> 数字 {
    可变 总和 = 0
    对 分 在 成绩表 {
        总和 = 总和 + 分
    }
    返回 总和 / 长度(成绩表)
}

// 纯函数：找最高分
纯功能 最高分(成绩表) -> 数字 {
    可变 最高 = 0
    对 分 在 成绩表 {
        若 分 > 最高 {
            最高 = 分
        }
    }
    返回 最高
}

// 函数：评级
功能 评级(分) -> 文本 {
    若 分 >= 90 {
        返回 "优秀"
    } 否则若 分 >= 75 {
        返回 "良好"
    } 否则若 分 >= 60 {
        返回 "及格"
    } 否则 {
        返回 "不及格"
    }
}

// 主程序
量 学生 = {
    名: "张小明",
    成绩: { 92, 85, 78, 96, 88 }
}

打印("=== 学生成绩系统 ===")
打印(`学生: ${学生.名}`)
打印(`平均分: ${平均分(学生.成绩)}`)
打印(`最高分: ${最高分(学生.成绩)}`)

打印("")
打印("=== 逐个评级 ===")
可变 序号 = 0
对 分 在 学生.成绩 {
    序号 = 序号 + 1
    打印(`第${序号}科: ${分}分 → ${评级(分)}`)
}

// 错误处理：空成绩表会除零
量 空成绩 = {}
量 结果 = 捕获(平均分(空成绩))
若 结果.成功 {
    打印("平均分:", 结果.值)
} 否则 {
    打印("计算失败:", 结果.错误)
}
