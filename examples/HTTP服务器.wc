// ============================================================
// 无错语言-加强版 示例：HTTP 服务器
// 起一个本地服务，有主页/JSON/404 路由
// ============================================================

// 主页处理函数
功能 主页(请求) -> 文本 {
    返回 "你好，这是无错语言写的服务器！\n你访问了: " + 请求.路径
}

// JSON 接口
功能 用户信息(请求) -> 表 {
    返回 {
        状态: 200,
        头: { "Content-Type": "application/json" },
        体: JSON编码({ 名: "张小明", 年龄: 18, 城市: "北京" })
    }
}

// 兜底路由
功能 兜底(请求) -> 表 {
    返回 { 状态: 404, 体: "没这个页面: " + 请求.路径 }
}

// 起服务器（后台运行，不阻塞）
量 服务器 = 服务(8899, {
    "/": 主页,
    "/api/user": 用户信息,
    "*": 兜底
})
打印("✅ 服务器已启动: http://127.0.0.1:8899")
打印("   状态:", 服务器.状态)

// 自己请求自己验证
量 测试1 = HTTP获取("http://127.0.0.1:8899/")
打印("")
打印("=== 请求 / ===")
打印("状态码:", 测试1.状态)
打印("内容:", 测试1.内容)

量 测试2 = HTTP获取("http://127.0.0.1:8899/api/user")
打印("")
打印("=== 请求 /api/user ===")
打印("内容:", 测试2.内容)

量 测试3 = HTTP获取("http://127.0.0.1:8899/不存在")
打印("")
打印("=== 请求 /不存在 ===")
打印("状态码:", 测试3.状态)

打印("")
打印("✅ 服务器测试完成！")
